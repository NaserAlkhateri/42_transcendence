{
	skip_install_trust
	servers {
		protocols h1 h2
	}
}

https://{$SIJIL_HOST:localhost} {
	encode zstd gzip

	@api path /api /api/* /health
	handle @api {
		request_body {
			max_size {$MAX_REQUEST_BYTES:1000000}
		}
		# Preserve the URI and let Caddy handle WebSocket upgrades on /api/v1/ws.
		reverse_proxy api:8000
	}

	handle /assets/* {
		root * /srv
		file_server
	}

	handle {
		root * /srv
		route {
			try_files {path} /index.html
			@index path /index.html
			header @index Cache-Control "no-cache"
			file_server
		}
	}

	@frontend not path /api /api/* /health
	header @frontend {
		X-Content-Type-Options nosniff
		Referrer-Policy same-origin
		X-Frame-Options DENY
		Strict-Transport-Security "max-age=31536000"
		Content-Security-Policy "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self' wss://{$SIJIL_HOST:localhost}; base-uri 'none'; object-src 'none'; frame-ancestors 'none'; form-action 'self'"
	}
}
