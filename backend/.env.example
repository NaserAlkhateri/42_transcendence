# Copy to backend/.env (git-ignored) for local runs outside Docker. Dummy values only.
DATABASE_URL=postgresql+psycopg://sijil:change-me@localhost:5432/sijil
SEED_DEMO_PASSWORD=change-me
# Optional. Session lifetime in hours (default 168 = 7 days).
SESSION_TTL_HOURS=168
# Optional. Keep true; set false only to debug over plain http on a host other than localhost.
COOKIE_SECURE=true
# Optional. A demo partner key the seed makes valid, for trying the partner API (doc/PARTNER_API.md).
# Generate your own: python -c "import secrets; print(f'sjl_{secrets.token_hex(4)}_{secrets.token_urlsafe(32)}')"
SEED_PARTNER_API_KEY=
# Optional. Partner API rate limit: requests per key per window, and the window in seconds.
PARTNER_RATE_LIMIT=60
PARTNER_RATE_WINDOW_SECONDS=60
