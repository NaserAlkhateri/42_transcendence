# Copy to .env at the repository root. Fill in the three passwords for a local demo.
POSTGRES_PASSWORD=
MINIO_ROOT_PASSWORD=
SEED_DEMO_PASSWORD=
# Set false for an empty database with the schema applied, e.g. on a hosted instance.
SEED_DEMO_DATA=true
SEED_PARTNER_API_KEY=

# Local demo. For hosted HTTPS use a DNS hostname, bind to an external interface,
# disable the demo seed and make ports 80 and 443 reachable for Caddy.
SIJIL_HOST=localhost
SIJIL_BIND_IP=127.0.0.1

# One subnet shared exclusively by Caddy and the API. Change if it overlaps a local network.
SIJIL_PROXY_SUBNET=172.30.252.0/24
MAX_REQUEST_BYTES=1000000
